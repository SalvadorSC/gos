# Copy to .env. Gos reads this file on startup and does not override
# variables that are already set in the environment. Never commit .env.

PORT=8080
# Leave unset to use <repo>/data. On a Sprite the default is fine.
# DATA_DIR=/home/sprite/gos/data

# Set to 1 to answer without a connector. Yard, sleep, and lives still run.
MOCK_LLM=1

# Cookie secret for Salvador. Use a long random value on the Sprite.
OWNER_TOKEN=change-me-local-only

# Sprites gateway. The Sprite calls this. It never sees the provider token.
GATEWAY_BASE=https://api.sprites.dev/v1/gateway

# From the OpenRouter connector page. Not the API key.
OPENROUTER_CONNECTION_ID=
# Path appended after the connection id. The connector's usage snippet wins
# if it differs. See the README.
OPENROUTER_PATH=/api/v1/chat/completions
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional. Set LLM_PROVIDER=ollama and OLLAMA_CONNECTION_ID to use Ollama Cloud
# instead of OpenRouter. Path below is the one Ollama documents.
LLM_PROVIDER=openrouter
OLLAMA_CONNECTION_ID=
OLLAMA_PATH=/v1/chat/completions
OLLAMA_MODEL=kimi-k3

# From the Pushover connector page. Not the application token.
PUSHOVER_CONNECTION_ID=
# The user key from the Pushover dashboard. The Sprite sends this as `user`.
PUSHOVER_USER_KEY=

# Gap that counts as a nap. The Sprite pauses about 30s after it goes idle.
SLEEP_GAP_MS=60000
# Owner messages on the live disk before puppy Gos grows up.
GROW_AFTER_MESSAGES=6
NUDGE_AFTER_HOURS=48
NUDGE_COOLDOWN_HOURS=24
# Stranger pings, so one visitor does not buzz the phone on every bark.
STRANGER_COOLDOWN_MS=1800000

# If set, POST /api/nudge with header x-gos-cron: <token> checks the walk.
# Leave empty to disable the endpoint.
CRON_TOKEN=
