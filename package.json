{
  "name": "gos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gos, a talking dog who lives on a Fly.io Sprite.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-client.mjs",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node dist/index.js",
    "dev": "node scripts/ensure-build.mjs && tsx src/index.ts",
    "art": "tsx scripts/draw-art.ts",
    "test": "node --import tsx --test test/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
